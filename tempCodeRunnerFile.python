import boto3
import os

# Initialize boto3 client
s3 = boto3.client(
    's3',
    aws_access_key_id='AKIA47CRYIP7AEJX6ERX',
    aws_secret_access_key='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',
    region_name='ap-south-1'
)

# Local folder path containing images
folder_path = r"C:\Users\SOUBHIK SHEET\Desktop\screenshots"

# Bucket name and S3 destination folder
bucket_name = 'soubhikpos'
s3_folder = 'uploads/'

# Valid image extensions
image_extensions = {'.jpg', '.jpeg', '.png', '.bmp', '.gif', '.tiff'}

# Loop through files in the folder
for filename in os.listdir(folder_path):
    if os.path.splitext(filename)[1].lower() in image_extensions:
        local_file_path = os.path.join(folder_path, filename)
        s3_key = os.path.join(s3_folder, filename).replace('\\', '/')

        try:
            s3.upload_file(local_file_path, bucket_name, s3_key)
            print(f"Uploaded: {filename} → s3://{bucket_name}/{s3_key}")
        except Exception as e:
            print(f"Failed to upload {filename}: {e}")
